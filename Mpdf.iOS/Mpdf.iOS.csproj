<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>17.4</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mpdf.iOS</RootNamespace>
    <AssemblyName>Mpdf.Portable.iOS</AssemblyName>
    <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <BundleIdentifier>com.msoft.mpdf</BundleIdentifier>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="11.3.23" />
    <PackageReference Include="SkiaSharp.NativeAssets.iOS" Version="2.88.9" />
    <PackageReference Include="bblanchon.PDFium.iOS" Version="160.0.8179" />
    <ProjectReference Include="..\Mpdf.App\Mpdf.App.csproj" />
  </ItemGroup>

</Project>
